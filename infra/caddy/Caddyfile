}
emo.1site.ai {
	@signup path /api/v1/auth/signup
	handle @signup {
		respond "Registration is closed." 403
	}
	@api path /api/v1/*
	handle @api {
		reverse_proxy dograh-api-1:8000
	}
	@audio path /voice-audio/*
	handle @audio {
		reverse_proxy minio:9000
	}
	handle {
		root * /srv/docs
		rewrite / /emo.html
		file_server
	}
}

features.1site.ai {
	root * /srv/docs/beakn-features
	encode gzip zstd
	header {
		Cache-Control "no-cache, must-revalidate"
		X-Content-Type-Options "nosniff"
	}
	file_server
}

# KIOT client proposals for Xpulsar Technology (Aug 2026).
# Static one-page HTML from /var/www/docs/pages. Lowercase URL variants are
# handled by symlinks on disk, NOT redir: Caddy path matchers are
# case-insensitive, so a lowercase redir rule also matches the uppercase
# target and loops. noindex is deliberate - these carry pricing.
pages.1site.ai {
	root * /srv/docs/pages
	encode gzip zstd
	header {
		Cache-Control "no-cache, must-revalidate"
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow"
	}
	file_server
}
