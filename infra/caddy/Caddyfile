# Beakn Home Visit App. Cloudflare proxy is OFF for this subdomain (DNS-only,
# matches the *.1site.ai pattern above). HVA-16 containerised the app onto
# mcp-network so Caddy reaches it by container hostname.
visits.beakn.in {
	reverse_proxy beakn-app:3001
}

# Hermes Agent web dashboard. The dashboard runs on the host bound to the
# hermes-network gateway IP (172.19.0.1) so only containers on that network
# can reach it. Caddy enforces HTTP basic auth in front because the dashboard
# exposes API keys. header_up Host rewrites the Host header so the dashboard's
# anti-DNS-rebinding check accepts the request.
agent.1site.ai {
	basic_auth {
		sandeep __REDACTED_BCRYPT_HASH__
	}
	reverse_proxy 172.19.0.1:9119 {
		header_up Host {upstream_hostport}
	}
}

# Honcho MCP auth-injecting proxy. claude.ai web's custom connector flow
# expects OAuth and doesn't support static headers, so this proxy adds the
# Honcho Authorization + workspace/user headers on the way through.
# IMPORTANT: The Honcho API key lives in plaintext here. If the key is
# rotated, this block must be updated too.
honcho.1site.ai {
    reverse_proxy https://mcp.honcho.dev {
        header_up Host mcp.honcho.dev
        header_up Authorization "Bearer __REDACTED__"
        header_up X-Honcho-User-Name "sandeep"
        header_up X-Honcho-Workspace-ID "sandeep-brain"
        transport http {
            tls
            tls_server_name mcp.honcho.dev
        }
    }
}

docs.1site.ai {
    root * /srv/docs
    @emoflash path /emo-flash/*
    header @emoflash Cache-Control "no-store"
    file_server
}

files.1site.ai {
	reverse_proxy filebrowser:80
}

# Supermemory MCP auth-injecting proxy. claude.ai web custom connectors do not
# support static headers, so this proxy adds the Bearer key + x-sm-project on
# the way through to supermemory's hosted MCP. Key is plaintext here; if it is
# rotated, update this block too.
sm.1site.ai {
    reverse_proxy https://mcp.supermemory.ai {
        header_up Host mcp.supermemory.ai
        header_up Authorization "Bearer __REDACTED__"
        header_up x-sm-project "sandeep"
        transport http {
            tls
            tls_server_name mcp.supermemory.ai
        }
    }
}

